{
  "manifest_version": 3,
  "name": "MangaFlow \u2014 Smooth Scrolling",
  "version": "1.4.0",
  "description": "Adjustable smooth auto-scrolling for long manga and comic pages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "permissions"
  ],
  "action": {
    "default_title": "MangaFlow",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-scrolling": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Start or pause MangaFlow scrolling"
    },
    "increase-speed": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Increase MangaFlow speed"
    },
    "decrease-speed": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Decrease MangaFlow speed"
    }
  },
  "host_permissions": [],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}