{
  "manifest_version": 3,
  "name": "MangaFlow — Smooth Scrolling",
  "version": "1.3.0",
  "description": "Adjustable smooth auto-scrolling for long manga and comic pages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "MangaFlow — Smooth Scrolling",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-scrolling": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Start or pause MangaFlow scrolling"
    },
    "increase-speed": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Increase MangaFlow speed"
    },
    "decrease-speed": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Decrease MangaFlow speed"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}